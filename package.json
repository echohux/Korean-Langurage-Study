        "react-router": "^8.4.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^10.10.0",
        "eslint-plugin-compat": "^7.0.2",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.6",
